<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F2F2F7">

        <LinearLayout
            android:id="@+id/headerBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="1dp">
            <TextView
                android:id="@+id/textSettingsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="設定"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="center"/>
            <Button
                android:id="@+id/btnDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="完了"
                android:textColor="#007AFF"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <TextView android:id="@+id/textDrawSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="言葉を引く" android:textColor="#666666" android:textSize="13sp" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                <LinearLayout android:id="@+id/cardDraw" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="24dp">

                    <LinearLayout android:id="@+id/btnDrawRandom" android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎲" android:textSize="18sp" android:layout_marginEnd="12dp"/>
                        <TextView android:id="@+id/textDrawRandom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="無作為に引く" android:textColor="#333333" android:textSize="16sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginStart="46dp"/>

                    <LinearLayout android:id="@+id/btnSenseMoment" android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✨" android:textSize="18sp" android:layout_marginEnd="12dp"/>
                        <TextView android:id="@+id/textSense" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="今の気配を読み取る" android:textColor="#333333" android:textSize="16sp"/>
                        <ProgressBar android:id="@+id/progressSense" android:layout_width="20dp" android:layout_height="20dp" android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:id="@+id/textSearchSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="言葉を探す" android:textColor="#666666" android:textSize="13sp" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                <LinearLayout android:id="@+id/cardSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="24dp" android:padding="16dp">

                    <LinearLayout android:id="@+id/groupScope" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:background="#E2E2E7" android:padding="2dp" android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/tabScopeAll" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="すべて" android:gravity="center" android:textSize="12sp" android:textColor="#333"/>
                        <TextView android:id="@+id/tabScopeQuote" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="言葉" android:gravity="center" android:textSize="12sp" android:textColor="#333"/>
                        <TextView android:id="@+id/tabScopeAuthor" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="著者" android:gravity="center" android:textSize="12sp" android:textColor="#333"/>
                        <TextView android:id="@+id/tabScopeTitle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="作品名" android:gravity="center" android:textSize="12sp" android:textColor="#333"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔍" android:textSize="18sp" android:layout_marginEnd="8dp"/>
                        <EditText android:id="@+id/editSearch" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@null" android:hint="キーワードで検索..." android:imeOptions="actionSearch" android:inputType="text" android:textSize="16sp"/>
                        <ProgressBar android:id="@+id/progressSearch" android:layout_width="20dp" android:layout_height="20dp" android:visibility="gone"/>
                        <Button android:id="@+id/btnSearch" android:layout_width="wrap_content" android:layout_height="36dp" android:text="検索" android:textSize="12sp" android:textColor="#FFFFFF" android:backgroundTint="#007AFF" android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:id="@+id/textAppearanceSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="外観 (テーマ)" android:textColor="#666666" android:textSize="13sp" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                <LinearLayout android:id="@+id/groupTheme" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:background="#E2E2E7" android:padding="2dp" android:layout_marginBottom="24dp">
                    <TextView android:id="@+id/tabThemeSystem" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="システム" android:gravity="center" android:textSize="14sp" android:textColor="#333"/>
                    <TextView android:id="@+id/tabThemeLight" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ライト" android:gravity="center" android:textSize="14sp" android:textColor="#333"/>
                    <TextView android:id="@+id/tabThemeDark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ダーク" android:gravity="center" android:textSize="14sp" android:textColor="#333"/>
                </LinearLayout>

                <TextView android:id="@+id/textLengthSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="文章の長さ" android:textColor="#666666" android:textSize="13sp" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                <LinearLayout android:id="@+id/groupLength" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:layout_marginBottom="24dp" android:background="#E2E2E7" android:padding="2dp">
                    <TextView android:id="@+id/tabLenShort" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="短文" android:gravity="center" android:textColor="#333" android:textSize="14sp"/>
                    <TextView android:id="@+id/tabLenLong" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="長文" android:gravity="center" android:textColor="#333" android:textSize="14sp"/>
                </LinearLayout>

                <TextView android:id="@+id/textAiSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI解説のレベル" android:textColor="#666666" android:textSize="13sp" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                <LinearLayout android:id="@+id/cardAi" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="24dp">
                    <Spinner android:id="@+id/spinnerAiLevel" android:layout_width="match_parent" android:layout_height="50dp" android:paddingHorizontal="8dp"/>
                </LinearLayout>
                <TextView android:id="@+id/textAiLevelDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="..." android:textColor="#888888" android:textSize="12sp" android:layout_marginStart="8dp" android:layout_marginTop="-16dp" android:layout_marginBottom="24dp"/>

                <!-- iOS SettingsView 同型: Language / 言語（英語 Language を常に残す） -->
                <TextView
                    android:id="@+id/textLanguageSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Language / 言語"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="4dp"/>
                <LinearLayout
                    android:id="@+id/cardLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌐"
                            android:textSize="22sp"
                            android:layout_marginEnd="12dp"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/textLanguageTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Language / 言語"
                                android:textColor="#333333"
                                android:textSize="16sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/textLanguageCaption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="中文 · Español · English"
                                android:textColor="#888888"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <Spinner
                        android:id="@+id/spinnerLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:paddingHorizontal="4dp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/textLanguageFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="If the UI is in the wrong language, tap here and choose yours."
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="24dp"/>

                <TextView android:id="@+id/textTicketSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="チケットストア" android:textColor="#666666" android:textSize="13sp" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                <LinearLayout android:id="@+id/cardTicket" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginBottom="24dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/textFreeTodayLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="本日の無料解説" android:textColor="#333333"/>
                        <TextView android:id="@+id/textFreeTickets" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 回" android:textColor="#4CAF50" android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/textPaidTicketsLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="所有チケット" android:textColor="#333333"/>
                        <TextView android:id="@+id/textPaidTickets" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 枚" android:textStyle="bold" android:textColor="#333333"/>
                    </LinearLayout>
                    <TextView android:id="@+id/textGoToStore" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ストアへ行く ›" android:textColor="#007AFF" android:textStyle="bold" android:layout_marginTop="16dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:id="@+id/textPrivacy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="プライバシーポリシー"
                        android:textColor="#333333"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↗"
                        android:textColor="#9E9E9E"
                        android:textSize="16sp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/overlayAtmosphere"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/alertContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="40dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingTop="24dp"
            android:elevation="10dp">

            <TextView android:id="@+id/textAtmosphereTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今の気配" android:textStyle="bold" android:textSize="18sp" android:textColor="#333" android:gravity="center"/>

            <TextView
                android:id="@+id/textAtmosphereResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="京都の\n春、昼\n晴れ / 穏やか / 新月\n(20°C)"
                android:textSize="20sp"
                android:textColor="#555"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView android:id="@+id/textAtmosphereAsk" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="この気配に重なる言葉を引きますか？" android:textSize="14sp" android:textColor="#888" android:gravity="center" android:layout_marginBottom="24dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal">
                <Button android:id="@+id/btnCancelAtmosphere" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="キャンセル" android:textColor="#666" android:background="@android:color/transparent"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#DDD"/>
                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                    <Button android:id="@+id/btnDrawAtmosphere" android:layout_width="match_parent" android:layout_height="match_parent" android:text="言葉を引く" android:textColor="#FF9500" android:textStyle="bold" android:background="@android:color/transparent"/>
                    <ProgressBar android:id="@+id/progressDrawAtmosphere" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>